<Project Sdk="Microsoft.NET.Sdk">
  <!-- A plain console runner (no test framework to download), like the macOS harness. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TypeLeast.Core\TypeLeast.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../service/test/fixtures/release-notes.json" Link="release-notes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../tests/conformance/client-v2.json" Link="client-v2.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
