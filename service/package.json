{
  "name": "typeleast-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "TypeLeast local service: on-device speech recognition (sherpa-onnx) plus cleanup with your own OpenAI-compatible model, over a loopback HTTP API used by the macOS and Windows apps.",
  "main": "lib/server.js",
  "exports": {
    ".": {
      "default": "./lib/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "typeleast-service": "bin/typeleast-service.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --expose-gc bin/typeleast-service.mjs",
    "setup-models": "node scripts/setup-models.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "opencc-js": "1.4.2",
    "pinyin-pro": "3.29.5",
    "sherpa-onnx-node": "1.13.8"
  }
}
